{
  "name": "flechajiu-jitsu-website",
  "compatibility_date": "2026-09-01",

  // Site estatico: sem "main", o Worker apenas serve os arquivos gerados
  // pelo `npm run build`. O not_found_handling devolve o index.html para
  // qualquer rota desconhecida, evitando 404 em links diretos.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
